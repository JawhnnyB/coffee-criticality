{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coffee and Criticality",
  "version": "0.20.0",
  "identifier": "com.coffeecriticality.game",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm --prefix .. run desktop:dev",
    "beforeBuildCommand": "npm --prefix .. run desktop:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Coffee & Criticality",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
